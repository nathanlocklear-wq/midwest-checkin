# Public Supabase values. Only use the anon/publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Required: unique password of at least 16 characters.
ADMIN_PASSWORD=
# Required: independent random secret of at least 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
