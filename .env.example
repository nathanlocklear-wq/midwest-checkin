# Server-only Supabase configuration. Never prefix the privileged key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A unique staff password, at least 16 characters.
ADMIN_PASSWORD=
# Independent random secret, at least 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
